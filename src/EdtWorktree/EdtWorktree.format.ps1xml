<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>EdtWorktree.Worktree</Name>
      <ViewSelectedBy>
        <TypeName>EdtWorktree.Worktree</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Project</Label></TableColumnHeader>
          <TableColumnHeader><Label>Worktree</Label></TableColumnHeader>
          <TableColumnHeader><Label>CodePath</Label></TableColumnHeader>
          <TableColumnHeader><Label>Workspace</Label></TableColumnHeader>
          <TableColumnHeader><Label>Locked</Label></TableColumnHeader>
          <TableColumnHeader><Label>Processes</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Project</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Worktree</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>CodePath</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Workspace</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Locked</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Processes</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>EdtWorktree.DoctorCheck</Name>
      <ViewSelectedBy>
        <TypeName>EdtWorktree.DoctorCheck</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Check</Label></TableColumnHeader>
          <TableColumnHeader><Label>Status</Label></TableColumnHeader>
          <TableColumnHeader><Label>Detail</Label></TableColumnHeader>
          <TableColumnHeader><Label>Fix</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Check</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Status</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Detail</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Fix</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>EdtWorktree.Project</Name>
      <ViewSelectedBy>
        <TypeName>EdtWorktree.Project</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Name</Label></TableColumnHeader>
          <TableColumnHeader><Label>RefBranch</Label></TableColumnHeader>
          <TableColumnHeader><Label>CloneBranch</Label></TableColumnHeader>
          <TableColumnHeader><Label>Extensions</Label></TableColumnHeader>
          <TableColumnHeader><Label>Reference</Label></TableColumnHeader>
          <TableColumnHeader><Label>RepoPath</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>RefBranch</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>CloneBranch</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Extensions</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Reference</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>RepoPath</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>EdtWorktree.ConfigSummary</Name>
      <ViewSelectedBy>
        <TypeName>EdtWorktree.ConfigSummary</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>ConfigFile</Label></TableColumnHeader>
          <TableColumnHeader><Label>ReposRoot</Label></TableColumnHeader>
          <TableColumnHeader><Label>WorktreesRoot</Label></TableColumnHeader>
          <TableColumnHeader><Label>WorkspacesRoot</Label></TableColumnHeader>
          <TableColumnHeader><Label>EdtCli</Label></TableColumnHeader>
          <TableColumnHeader><Label>Projects</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>ConfigFile</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>ReposRoot</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>WorktreesRoot</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>WorkspacesRoot</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>EdtCli</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>@($_.Projects) -join ', '</ScriptBlock></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>EdtWorktree.ReferenceUpdate</Name>
      <ViewSelectedBy>
        <TypeName>EdtWorktree.ReferenceUpdate</TypeName>
      </ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Project</Label></TableColumnHeader>
          <TableColumnHeader><Label>Status</Label></TableColumnHeader>
          <TableColumnHeader><Label>Detail</Label></TableColumnHeader>
          <TableColumnHeader><Label>Seconds</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Project</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Status</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Detail</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Seconds</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
  </ViewDefinitions>
</Configuration>
