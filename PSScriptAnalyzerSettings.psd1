@{
    # Правила, сознательно отключённые для этого модуля.
    ExcludeRules = @(
        # Команды печатают ход работы в консоль и раскрашивают шаги; это
        # интерактивный CLI, а не библиотека, возвращающая объекты в конвейер.
        # Там, где результат нужен как данные (Get-EdtWorktreeList), объекты
        # возвращаются штатно.
        'PSAvoidUsingWriteHost'

        # Имена вида Get-EdtWtWorkspaceProjectNames описывают множественный
        # результат и уже зафиксированы в документации и вызовах.
        'PSUseSingularNouns'
    )
}
